# ==============================================================================
# Enterprise Inventory & Order Backend API - Environment Template
# Duplicate this file to '.env' and provide real secrets for local execution.
# NEVER commit the active '.env' file containing secrets to version control.
# ==============================================================================

# Application Configuration
APP_NAME="Enterprise Inventory & Order API"
APP_VERSION=1.0.0
API_V1_STR=/api/v1
DEBUG=False
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Authentication
# CRITICAL: Generate a cryptographically strong secret (e.g., `openssl rand -hex 32`)
SECRET_KEY=change_this_in_production_jwt_secret_key_min_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inventory_db

# Optional Direct Database URL override (e.g. for managed cloud databases)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inventory_db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
